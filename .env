# Server Configuration
SPRING_LOCAL_PORT=8080
SPRING_DOCKER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration
MONGODB_USER=root
MONGODB_PASSWORD=123456
MONGODB_DATABASE=auth_db
MONGODB_LOCAL_PORT=27017
MONGODB_DOCKER_PORT=27017
SPRING_DATA_MONGODB_URI=mongodb://root:123456@mongo:27017/auth_db?authSource=admin
SPRING_DATA_MONGODB_DATABASE=auth_db

# JWT Configuration
JWT_SECRET=U2VjcmV0b1N1cGVyU2VndXJvRGVBdXRlbnRpY2FjaW9u
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000
auth-ms.app.jwtSecret=U2VjcmV0b1N1cGVyU2VndXJvRGVBdXRlbnRpY2FjaW9u
auth-ms.app.jwtExpirationMs=3600000
auth-ms.app.jwtRefreshExpirationMs=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With,Accept,Origin
CORS_MAX_AGE=3600

# Logging Configuration
LOGGING_LEVEL=INFO
LOGGING_PATTERN=%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n

# Security Configuration
SECURITY_REQUIRE_SSL=false
SECURITY_SESSION_TIMEOUT=3600