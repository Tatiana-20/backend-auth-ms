# Variables Mongo
MONGODB_USER=root
MONGODB_PASSWORD=123456
MONGODB_DATABASE=auth_db
MONGODB_LOCAL_PORT=27017
MONGODB_DOCKER_PORT=27017

# Puertos de Spring
SPRING_LOCAL_PORT=8080
SPRING_DOCKER_PORT=8080

# Mongo URI (para Spring Boot)
SPRING_DATA_MONGODB_URI=mongodb://root:123456@mongo:27017/auth_db?authSource=admin
SPRING_DATA_MONGODB_DATABASE=auth_db


# JWT config
auth-ms.app.jwtSecret=U2VjcmV0b1N1cGVyU2VndXJvRGVBdXRlbnRpY2FjaW9u
auth-ms.app.jwtExpirationMs=3600000
auth-ms.app.jwtRefreshExpirationMs=86400000
